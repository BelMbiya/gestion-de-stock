generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  IT_MANAGER
  TECHNICIAN
  AUDITOR
  EMPLOYEE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  BROKEN
  RETIRED
  LOST
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum InventoryCheckStatus {
  FOUND
  MISSING
  DAMAGED
  MOVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  IDENTIFIED
  DIAGNOSING
  IN_PROGRESS
  WAITING_PART
  RESOLVED
  CLOSED
}

/// Unitaire : un numero de serie, un detenteur. En vrac : une reference et une quantite.
enum TrackingMode {
  SERIALIZED
  BULK
}

enum HolderType {
  PERSON
  COLLECTIVE
}

/// Dotation : sans date de retour. Pret : date de retour obligatoire.
enum AssignmentKind {
  DOTATION
  LOAN
}

enum ReturnOutcome {
  GOOD
  TO_REPAIR
  LOST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  TRANSFER
  STATUS_CHANGE
  INCIDENT_UPDATE
  SIGN_IN
  SIGN_OUT
}

model User {
  id                  String            @id @default(cuid())
  firebaseUid         String            @unique
  email               String            @unique
  name                String?
  photoUrl            String?
  role                UserRole          @default(EMPLOYEE)
  /// Acces revoque (depart, mutation) : la connexion est refusee, l'historique reste intact.
  active              Boolean           @default(true)
  departmentId        String?
  department          Department?       @relation(fields: [departmentId], references: [id])
  createdAssets       Asset[]           @relation("AssetCreatedBy")
  issuedAssignments   AssetAssignment[] @relation("AssignmentIssuedBy")
  returnedAssignments AssetAssignment[] @relation("AssignmentReturnedBy")
  assignedIncidents   Incident[]        @relation("IncidentAssignee")
  reportedIncidents   Incident[]        @relation("IncidentReporter")
  incidentUpdates     IncidentUpdate[]
  stockMovements      StockMovement[]   @relation("MovementPerformedBy")
  inventoryChecks     InventoryCheck[]  @relation("InventoryCheckedBy")
  auditLogs           AuditLog[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([departmentId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  holders     Holder[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Personne ou collectif (ex. « AGENTS », postes partages du call center) qui detient du materiel.
model Holder {
  id             String            @id @default(cuid())
  type           HolderType        @default(PERSON)
  fullName       String
  matricule      String?           @unique
  process        String?
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id])
  active         Boolean           @default(true)
  assignments    AssetAssignment[]
  stockMovements StockMovement[]   @relation("MovementBeneficiary")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([fullName])
  @@index([active])
  @@index([departmentId])
}

model Location {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  assets          Asset[]
  fromMovements   StockMovement[]  @relation("MovementFromLocation")
  toMovements     StockMovement[]  @relation("MovementToLocation")
  inventoryChecks InventoryCheck[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// Famille de materiel (Informatique, Peripheriques, Reseau…), regroupe des types.
model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  assets      Asset[]
  types       AssetType[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Type de materiel (Souris, Laptop…) : son prefixe genere les codes (MS-0001, LAP-0001…).
model AssetType {
  id                  String       @id @default(cuid())
  prefix              String       @unique
  name                String
  categoryId          String
  category            Category     @relation(fields: [categoryId], references: [id])
  defaultTrackingMode TrackingMode @default(SERIALIZED)
  /// Prochain numero a attribuer ; jamais decremente (un code n'est pas reutilise).
  nextNumber          Int          @default(1)
  active              Boolean      @default(true)
  assets              Asset[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([categoryId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  notes     String?
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id              String            @id @default(cuid())
  /// Code materiel genere selon le type (MS-0001) ; definitif.
  sku             String            @unique
  /// Ancienne reference de l'Excel (KYC-ITEQUI-0046) ; « #2 » pour une ligne multiple decoupee.
  importRef       String?           @unique
  typeId          String
  type            AssetType         @relation(fields: [typeId], references: [id])
  barcode         String?           @unique
  serialNumber    String?           @unique
  name            String
  description     String?
  brand           String?
  model           String?
  imageUrl        String?
  systemOs        String?
  storageRam      String?
  ownerLabel      String?
  custodianName   String?
  workstationCode String?
  processLabel    String?
  assetGroup      String?
  trackingMode    TrackingMode      @default(SERIALIZED)
  status          AssetStatus       @default(AVAILABLE)
  condition       AssetCondition    @default(GOOD)
  unit            String            @default("unite")
  /// Unitaire : toujours 1. En vrac : quantite en stock.
  quantityOnHand  Int               @default(1)
  /// Seuil d'alerte (en vrac uniquement) ; 0 = alerte seulement en rupture.
  minQuantity     Int               @default(0)
  purchaseDate    DateTime?
  purchaseValue   Decimal?          @db.Decimal(12, 2)
  warrantyUntil   DateTime?
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id])
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  createdById     String?
  createdBy       User?             @relation("AssetCreatedBy", fields: [createdById], references: [id])
  assignments     AssetAssignment[]
  stockMovements  StockMovement[]
  inventoryChecks InventoryCheck[]
  incidents       Incident[]
  auditLogs       AuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([locationId])
  @@index([supplierId])
  @@index([status])
  @@index([barcode])
  @@index([trackingMode])
  @@index([typeId])
}

model AssetAssignment {
  id               String           @id @default(cuid())
  assetId          String
  asset            Asset            @relation(fields: [assetId], references: [id])
  holderId         String
  holder           Holder           @relation(fields: [holderId], references: [id])
  kind             AssignmentKind   @default(DOTATION)
  status           AssignmentStatus @default(ACTIVE)
  assignedAt       DateTime         @default(now())
  /// Obligatoire pour un pret, absent pour une dotation.
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  returnOutcome    ReturnOutcome?
  issuedById       String?
  issuedBy         User?            @relation("AssignmentIssuedBy", fields: [issuedById], references: [id])
  returnedById     String?
  returnedBy       User?            @relation("AssignmentReturnedBy", fields: [returnedById], references: [id])
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([assetId])
  @@index([holderId])
  @@index([status])
  @@index([kind])
  @@index([expectedReturnAt])
  @@index([issuedById])
  @@index([returnedById])
}

model StockMovement {
  id             String       @id @default(cuid())
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id])
  type           MovementType
  /// Quantite deplacee ; pour un ajustement, ecart signe (ex. -2).
  quantity       Int          @default(1)
  /// Beneficiaire d'une sortie d'article en vrac (facultatif).
  holderId       String?
  holder         Holder?      @relation("MovementBeneficiary", fields: [holderId], references: [id])
  fromLocationId String?
  fromLocation   Location?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("MovementToLocation", fields: [toLocationId], references: [id])
  performedById  String?
  performedBy    User?        @relation("MovementPerformedBy", fields: [performedById], references: [id])
  reason         String?
  movedAt        DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([assetId])
  @@index([type])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedById])
  @@index([holderId])
}

model InventorySession {
  id          String           @id @default(cuid())
  name        String
  description String?
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  checks      InventoryCheck[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model InventoryCheck {
  id                 String               @id @default(cuid())
  sessionId          String
  session            InventorySession     @relation(fields: [sessionId], references: [id])
  assetId            String
  asset              Asset                @relation(fields: [assetId], references: [id])
  expectedLocationId String?
  expectedLocation   Location?            @relation(fields: [expectedLocationId], references: [id])
  checkedById        String?
  checkedBy          User?                @relation("InventoryCheckedBy", fields: [checkedById], references: [id])
  status             InventoryCheckStatus
  notes              String?
  checkedAt          DateTime             @default(now())

  @@unique([sessionId, assetId])
  @@index([assetId])
  @@index([expectedLocationId])
  @@index([checkedById])
  @@index([status])
}

model Incident {
  id           String            @id @default(cuid())
  reference    String            @unique
  assetId      String
  asset        Asset             @relation(fields: [assetId], references: [id])
  title        String
  description  String?
  severity     IncidentSeverity  @default(MEDIUM)
  status       IncidentStatus    @default(IDENTIFIED)
  reporterId   String?
  reporter     User?             @relation("IncidentReporter", fields: [reporterId], references: [id])
  assigneeId   String?
  assignee     User?             @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  identifiedAt DateTime          @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  updates      IncidentUpdate[]
  parts        MaintenancePart[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([assetId])
  @@index([severity])
  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
}

model IncidentUpdate {
  id         String          @id @default(cuid())
  incidentId String
  incident   Incident        @relation(fields: [incidentId], references: [id])
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id])
  statusFrom IncidentStatus?
  statusTo   IncidentStatus?
  comment    String
  createdAt  DateTime        @default(now())

  @@index([incidentId])
  @@index([authorId])
  @@index([statusTo])
}

model MaintenancePart {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  name       String
  reference  String?
  quantity   Int      @default(1)
  unitCost   Decimal? @db.Decimal(12, 2)
  usedAt     DateTime @default(now())

  @@index([incidentId])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  description String?
  metadata    Json?
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id])
  assetId     String?
  asset       Asset?      @relation(fields: [assetId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([assetId])
}
