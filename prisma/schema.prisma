generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  IT_MANAGER
  TECHNICIAN
  AUDITOR
  EMPLOYEE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  BROKEN
  RETIRED
  LOST
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum InventoryCheckStatus {
  FOUND
  MISSING
  DAMAGED
  MOVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  IDENTIFIED
  DIAGNOSING
  IN_PROGRESS
  WAITING_PART
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  TRANSFER
  STATUS_CHANGE
  INCIDENT_UPDATE
  SIGN_IN
  SIGN_OUT
}

model User {
  id                String            @id @default(cuid())
  firebaseUid       String            @unique
  email             String            @unique
  name              String?
  photoUrl          String?
  role              UserRole          @default(EMPLOYEE)
  departmentId      String?
  department        Department?       @relation(fields: [departmentId], references: [id])
  createdAssets     Asset[]           @relation("AssetCreatedBy")
  assignments       AssetAssignment[] @relation("AssignedUser")
  assignedIncidents Incident[]        @relation("IncidentAssignee")
  reportedIncidents Incident[]        @relation("IncidentReporter")
  incidentUpdates   IncidentUpdate[]
  stockMovements    StockMovement[]   @relation("MovementPerformedBy")
  inventoryChecks   InventoryCheck[]  @relation("InventoryCheckedBy")
  auditLogs         AuditLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([departmentId])
}

model Department {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  users       User[]
  assignments AssetAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Location {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String?
  assets          Asset[]
  fromMovements   StockMovement[]  @relation("MovementFromLocation")
  toMovements     StockMovement[]  @relation("MovementToLocation")
  inventoryChecks InventoryCheck[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  notes     String?
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id              String            @id @default(cuid())
  sku             String            @unique
  barcode         String?           @unique
  serialNumber    String?           @unique
  name            String
  description     String?
  brand           String?
  model           String?
  imageUrl        String?
  status          AssetStatus       @default(AVAILABLE)
  condition       AssetCondition    @default(GOOD)
  unit            String            @default("unite")
  quantityOnHand  Int               @default(1)
  minQuantity     Int               @default(0)
  reorderPoint    Int               @default(1)
  maxQuantity     Int?
  purchaseDate    DateTime?
  purchaseValue   Decimal?          @db.Decimal(12, 2)
  warrantyUntil   DateTime?
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  locationId      String?
  location        Location?         @relation(fields: [locationId], references: [id])
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id])
  createdById     String?
  createdBy       User?             @relation("AssetCreatedBy", fields: [createdById], references: [id])
  assignments     AssetAssignment[]
  stockMovements  StockMovement[]
  inventoryChecks InventoryCheck[]
  incidents       Incident[]
  auditLogs       AuditLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([locationId])
  @@index([supplierId])
  @@index([status])
  @@index([barcode])
}

model AssetAssignment {
  id           String           @id @default(cuid())
  assetId      String
  asset        Asset            @relation(fields: [assetId], references: [id])
  assignedToId String?
  assignedTo   User?            @relation("AssignedUser", fields: [assignedToId], references: [id])
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  assignedAt         DateTime         @default(now())
  expectedReturnAt   DateTime?
  returnedAt         DateTime?
  status             AssignmentStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([assetId])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([status])
  @@index([expectedReturnAt])
}

model StockMovement {
  id             String       @id @default(cuid())
  assetId        String
  asset          Asset        @relation(fields: [assetId], references: [id])
  type           MovementType
  quantity       Int          @default(1)
  fromLocationId String?
  fromLocation   Location?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("MovementToLocation", fields: [toLocationId], references: [id])
  performedById  String?
  performedBy    User?        @relation("MovementPerformedBy", fields: [performedById], references: [id])
  reason         String?
  movedAt        DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([assetId])
  @@index([type])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([performedById])
}

model InventorySession {
  id          String           @id @default(cuid())
  name        String
  description String?
  startedAt   DateTime         @default(now())
  endedAt     DateTime?
  checks      InventoryCheck[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model InventoryCheck {
  id                 String               @id @default(cuid())
  sessionId          String
  session            InventorySession     @relation(fields: [sessionId], references: [id])
  assetId            String
  asset              Asset                @relation(fields: [assetId], references: [id])
  expectedLocationId String?
  expectedLocation   Location?            @relation(fields: [expectedLocationId], references: [id])
  checkedById        String?
  checkedBy          User?                @relation("InventoryCheckedBy", fields: [checkedById], references: [id])
  status             InventoryCheckStatus
  notes              String?
  checkedAt          DateTime             @default(now())

  @@unique([sessionId, assetId])
  @@index([assetId])
  @@index([expectedLocationId])
  @@index([checkedById])
  @@index([status])
}

model Incident {
  id           String            @id @default(cuid())
  reference    String            @unique
  assetId      String
  asset        Asset             @relation(fields: [assetId], references: [id])
  title        String
  description  String?
  severity     IncidentSeverity  @default(MEDIUM)
  status       IncidentStatus    @default(IDENTIFIED)
  reporterId   String?
  reporter     User?             @relation("IncidentReporter", fields: [reporterId], references: [id])
  assigneeId   String?
  assignee     User?             @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  identifiedAt DateTime          @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  updates      IncidentUpdate[]
  parts        MaintenancePart[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([assetId])
  @@index([severity])
  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
}

model IncidentUpdate {
  id         String          @id @default(cuid())
  incidentId String
  incident   Incident        @relation(fields: [incidentId], references: [id])
  authorId   String?
  author     User?           @relation(fields: [authorId], references: [id])
  statusFrom IncidentStatus?
  statusTo   IncidentStatus?
  comment    String
  createdAt  DateTime        @default(now())

  @@index([incidentId])
  @@index([authorId])
  @@index([statusTo])
}

model MaintenancePart {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  name       String
  reference  String?
  quantity   Int      @default(1)
  unitCost   Decimal? @db.Decimal(12, 2)
  usedAt     DateTime @default(now())

  @@index([incidentId])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityType  String
  entityId    String
  description String?
  metadata    Json?
  actorId     String?
  actor       User?       @relation(fields: [actorId], references: [id])
  assetId     String?
  asset       Asset?      @relation(fields: [assetId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([assetId])
}
